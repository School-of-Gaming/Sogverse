# Supabase Configuration (remote — used for local dev server)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-database-password

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
# Signing secret for the products webhook endpoint
# (`/api/webhooks/stripe/products` — see docs/architecture/products.md §3 carve-out).
# Configure a webhook endpoint in the Stripe Dashboard pointing at
# /api/webhooks/stripe/products with this secret.
STRIPE_PRODUCTS_WEBHOOK_SECRET=your-stripe-products-webhook-secret

# Daily.co Configuration (voice chat)
DAILY_API_KEY=your-daily-api-key
NEXT_PUBLIC_DAILY_DOMAIN=your-daily-subdomain

# Brevo Configuration (transactional email)
BREVO_API_KEY=your-brevo-api-key

# Minecraft Server
MINECRAFT_SERVER_API_KEY=your-minecraft-server-api-key

# Site URL (used for OG metadata, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Parent-PIN unlock cookie signing secret (HMAC key for the "PIN verified"
# session cookie — see src/services/pin/CLAUDE.md). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_COOKIE_SECRET=your-pin-cookie-secret

# Discord Bot
DISCORD_APPLICATION_ID=your-discord-application-id
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_BOT_TOKEN=your-discord-bot-token

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Azure / Microsoft Graph (password reset bot)
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Meta advertising. The pixel id is public and non-secret — it names the
# advertiser account, and the browser gets it anyway. Unset (or holding a
# placeholder rather than digits) means the pixel never loads AND our servers
# report nothing: it is the switch for both halves. The real value lives in
# Vercel's environment variables and never in git. The pixel only loads once a
# visitor has accepted marketing cookies, never for a signed-in gamer, and only
# on the marketing pages listed in src/lib/marketing-pages.ts.
#
# The id and the token below are always changed together: a Conversions API
# token only works against the dataset it was generated for, so a mismatched
# pair reports nothing. The running server uses the staging dataset locally
# and on Preview, and the live one on Vercel Production.
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# The Conversions API token, from Events Manager -> the pixel's Settings ->
# Conversions API -> Generate access token. A server secret: it can post events
# to that pixel, so it never becomes NEXT_PUBLIC_ anything. Unset means account
# creation and enrolments are reported nowhere; the browser pixel is unaffected.
META_CONVERSIONS_API_ACCESS_TOKEN=your-meta-conversions-api-access-token

# The live pixel and its own token, carried here under their own names so a
# checkout has the values for the Vercel Production writes and for live checks,
# without the running server ever pointing at the live dataset. Never the pair
# the local server authenticates with.
NEXT_PUBLIC_META_PIXEL_ID_PRODUCTION=your-meta-production-pixel-id
META_CONVERSIONS_API_ACCESS_TOKEN_PRODUCTION=your-meta-production-conversions-api-access-token

# Optional, and for a PREVIEW deployment only: the code from Events Manager's
# Test Events tab. Set it and every server-side event shows up there live
# instead of counting as ordinary traffic, which is how the flow is verified end
# to end. Never set in production.
META_CONVERSIONS_API_TEST_EVENT_CODE=your-meta-test-event-code

# Google Tag Manager. The container id is public and non-secret — the browser
# downloads the container by it. Unset (or holding a placeholder rather than a
# GTM- id) means the container never loads, which is what every environment but
# production and preview gets.
#
# The container is a general-purpose script injector, so it runs behind the same
# gates as the Meta pixel and for the same reasons: marketing consent, never for
# a signed-in gamer, and only on the pages in src/lib/marketing-pages.ts. A tag
# added to the container inherits those gates and cannot widen them.
#
# Marketing rather than analytics, and the same word as the pixel's gate on
# purpose: the container mints a persistent client id and carries advertising
# tags, so a visitor who took only analytics must not get one. Analytics on this
# site is Vercel's, which counts visits without a cookie and without an
# identifier — which is what the consent strip and the privacy policy say it is.
#
# Which vendors it carries is configured in the Tag Manager UI rather than here,
# so this one variable is the whole of the app's side of it. Meta is deliberately
# NOT among them — the pixel above is loaded directly and its conversions are
# reported server-side, and a Meta tag in the container would double-count every
# page view with no event id to deduplicate against.
NEXT_PUBLIC_GTM_CONTAINER_ID=your-google-tag-manager-container-id

# Partner API — Lynx Educate. LYNX_PARTNER_API_KEY is the key this server
# accepts: the staging key locally and on Preview, the production key on Vercel
# Production. The production key is also kept here, under its own name, for
# handing over to Lynx and for live checks — never as the key a local server
# accepts, since the local app reads staging.
LYNX_PARTNER_API_KEY=your-lynx-partner-api-key
LYNX_PARTNER_API_KEY_PRODUCTION=your-lynx-partner-api-production-key

# Vercel Web Analytics, read by the partner API's /traffic (server-only). The
# token is a School of Gaming team-scoped Vercel access token created in the
# dashboard; the team and project ids below are the Sogverse project's own
# (not secret). Unset means /traffic answers 500 server_misconfigured; every
# other partner resource is unaffected.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_TEAM_ID=team_oSU9V92LfCv0FOlcB1aZN0SX
VERCEL_ANALYTICS_PROJECT_ID=prj_25TSZ5ipsOc5Jx8s3nNMqrnXtVWA
