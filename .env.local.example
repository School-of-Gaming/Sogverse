# Supabase Configuration (remote — used for local dev server)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-database-password

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
# Signing secret for the products webhook endpoint
# (`/api/webhooks/stripe/products` — see docs/architecture/products.md §3 carve-out).
# Configure a webhook endpoint in the Stripe Dashboard pointing at
# /api/webhooks/stripe/products with this secret.
STRIPE_PRODUCTS_WEBHOOK_SECRET=your-stripe-products-webhook-secret

# Daily.co Configuration (voice chat)
DAILY_API_KEY=your-daily-api-key
NEXT_PUBLIC_DAILY_DOMAIN=your-daily-subdomain

# Brevo Configuration (transactional email)
BREVO_API_KEY=your-brevo-api-key

# Minecraft Server
MINECRAFT_SERVER_API_KEY=your-minecraft-server-api-key

# Site URL (used for OG metadata, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Parent-PIN unlock cookie signing secret (HMAC key for the "PIN verified"
# session cookie — see src/services/pin/CLAUDE.md). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_COOKIE_SECRET=your-pin-cookie-secret

# Discord Bot
DISCORD_APPLICATION_ID=your-discord-application-id
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_BOT_TOKEN=your-discord-bot-token

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Azure / Microsoft Graph (password reset bot)
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Meta advertising. The pixel id is public and non-secret — it names the
# advertiser account, and the browser gets it anyway. Unset (or holding a
# placeholder rather than digits) means the pixel never loads AND our servers
# report nothing: it is the switch for both halves. The real value lives in
# Vercel's environment variables and never in git. The pixel only loads once a
# visitor has accepted marketing cookies, never for a signed-in gamer, and only
# on the marketing pages listed in src/lib/marketing-pages.ts.
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# The Conversions API token, from Events Manager -> the pixel's Settings ->
# Conversions API -> Generate access token. A server secret: it can post events
# to that pixel, so it never becomes NEXT_PUBLIC_ anything. Unset means account
# creation and enrolments are reported nowhere; the browser pixel is unaffected.
META_CONVERSIONS_API_ACCESS_TOKEN=your-meta-conversions-api-access-token

# Optional, and for a PREVIEW deployment only: the code from Events Manager's
# Test Events tab. Set it and every server-side event shows up there live
# instead of counting as ordinary traffic, which is how the flow is verified end
# to end. Never set in production.
META_CONVERSIONS_API_TEST_EVENT_CODE=your-meta-test-event-code
