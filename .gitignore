# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
services/*/node_modules
services/*/dist
services/*/.auth-cache
packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# The SOG-UI demo is a Next app of its own, run with Next's directory
# argument, so its build output lands beside the app rather than at the root.
# Its next-env.d.ts needs no entry: the bare `next-env.d.ts` under "typescript"
# below already matches at every depth, and the root does not commit its own.
packages/*/demo/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# supabase
.supabase/
supabase/.temp/

# IDE
.idea/
.vscode/
*.swp
*.swo

# claude code (agent worktrees are local scratch checkouts)
.claude/worktrees/

# Reconciliation migrations emitted by scripts/diff-geonames.mjs. They land here
# rather than in supabase/migrations/ precisely because they carry no version
# number yet — the number is picked against remote history when the migration is
# pushed, and the file is renamed and moved then. Until that happens it is a
# working artifact, and committing one from this staging area would commit a
# migration nobody can order.
supabase/reconciliations/

# Working artifacts of the observation scripts (scripts/watch-registration.mjs,
# supabase-compute-metrics.mjs, speed-insights.mjs). These are measurements of a
# moment — one JSONL row per poll of a live event — so they are worth keeping on
# disk and reading back later, but they are data rather than source: they never
# affect a build, they would collide between machines, and a registration
# opening writes thousands of rows nobody should review in a diff.
scripts/output/

# Logs
logs
*.log

# Keep example env files for reference
!.env.local.example
!.env.test.local.example

.vercel
.env*.local

# Working artifacts of scripts/minecraft-edu-accounts.mjs. The plan file and the
# CSV both carry the *live passwords* of every shared Minecraft Education class
# login, and the deleted-accounts snapshot is a directory dump — none of the
# three may ever reach a commit. They are handed to the admin out of band and
# regenerated on the next reset, so nothing is lost by never tracking them.
minecraft-edu-plan.json
minecraft-edu-accounts.csv
deleted-accounts-*.json
