# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
services/*/node_modules
services/*/dist
services/*/.auth-cache
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# supabase
.supabase/
supabase/.temp/

# IDE
.idea/
.vscode/
*.swp
*.swo

# claude code (agent worktrees are local scratch checkouts)
.claude/worktrees/

# Reconciliation migrations emitted by scripts/diff-geonames.mjs. They land here
# rather than in supabase/migrations/ precisely because they carry no version
# number yet — the number is picked against remote history when the migration is
# pushed, and the file is renamed and moved then. Until that happens it is a
# working artifact, and committing one from this staging area would commit a
# migration nobody can order.
supabase/reconciliations/

# Logs
logs
*.log

# Keep example env files for reference
!.env.local.example
!.env.test.local.example

.vercel
.env*.local
