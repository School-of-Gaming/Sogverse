# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
services/*/node_modules
services/*/dist
services/*/.auth-cache
packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# The SOG-UI demo is a Next app of its own, run with Next's directory
# argument, so its build output lands beside the app rather than at the root.
# Its next-env.d.ts needs no entry: the bare `next-env.d.ts` under "typescript"
# below already matches at every depth, and the root does not commit its own.
packages/*/demo/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# supabase
.supabase/
supabase/.temp/

# IDE
.idea/
.vscode/
*.swp
*.swo

# claude code (agent worktrees are local scratch checkouts)
.claude/worktrees/

# Reconciliation migrations emitted by scripts/diff-geonames.mjs. They land here
# rather than in supabase/migrations/ precisely because they carry no version
# number yet — the number is picked against remote history when the migration is
# pushed, and the file is renamed and moved then. Until that happens it is a
# working artifact, and committing one from this staging area would commit a
# migration nobody can order.
supabase/reconciliations/

# Working artifacts of every script, each under scripts/output/<script-name>/
# (see scripts/CLAUDE.md). Output is data rather than source — logs of a live
# event, raw API dumps, and account handouts carrying live passwords — so none of
# it may reach a commit. A script writing anywhere else is the bug to fix, not a
# reason to add another entry here.
scripts/output/

# Logs
logs
*.log

# Keep example env files for reference
!.env.local.example
!.env.test.local.example

.vercel
.env*.local
